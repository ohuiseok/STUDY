 // 2. BFS를 위한 자료구조 준비
  Queue<Integer> queue = new LinkedList<>();
  boolean[] visited = new boolean[n + 1];
  
  // 3. BFS 시작 (1번 노드부터)
  queue.offer(1);
  visited[1] = true;
  distance[1] = 0;
  
  
  while(!queue.isEmpty()) {
      int current = queue.poll();
      
      // 현재 노드와 연결된 모든 노드 탐색
      for(int next : adj.get(current)) {
          if(!visited[next]) {
              visited[next] = true;
              //로직
              queue.offer(next);
          }
      }
  }
